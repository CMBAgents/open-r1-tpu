# Copy to .env (gitignored by the repo's blanket `.env` rule) and replace
# every value below. These are the only inputs docker-compose.yaml reads;
# the compose file itself carries no deployment-specific value.
#
# `scripts/gen_langfuse_env.sh` writes a complete, internally consistent .env
# (and the matching configs/tracing.yaml) for you -- prefer it to hand-editing
# this template, because .env has NO variable interpolation and several values
# below must be kept byte-equal by hand otherwise (noted inline).
#
# The tracing config's `langfuse.host`/`langfuse.port` (configs/tracing.yaml,
# also gitignored) must describe this same endpoint as the eval process
# reaches it -- LANGFUSE_WEB_PORT here and langfuse.port there are the same
# port and must agree, and langfuse.host must be an address that resolves to
# LANGFUSE_WEB_BIND below from wherever the eval runs.

# --- Ports ---
# Every port below is bound to 127.0.0.1 by the compose file. The one
# exception is the web port, whose bind address is LANGFUSE_WEB_BIND: set it
# to an interface the evaluation host can reach when the two run on different
# machines, and firewall that port to the eval host. Leave it at 127.0.0.1
# for a single-host deployment, where the UI is reached by SSH port-forward.
LANGFUSE_WEB_BIND=127.0.0.1
LANGFUSE_WEB_PORT=3000
LANGFUSE_WORKER_PORT=3030
POSTGRES_PORT=5432
REDIS_PORT=6379
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
MINIO_API_PORT=9090
MINIO_CONSOLE_PORT=9091

# --- Datastore credentials (internal to the compose network) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres
# langfuse-web/worker connect with this, NOT with POSTGRES_PASSWORD directly.
# .env is not interpolated, so the password here is a literal copy of
# POSTGRES_PASSWORD above -- change both together.
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/postgres

REDIS_HOST=redis
REDIS_AUTH=changeme

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_CLUSTER_ENABLED=false

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=changeme

# --- Langfuse's S3 client, pointed at the bundled MinIO ---
# ACCESS_KEY_ID must equal MINIO_ROOT_USER and SECRET_ACCESS_KEY must equal
# MINIO_ROOT_PASSWORD, for both the event and the media bucket. Leaving these
# at the compose defaults while MINIO_ROOT_PASSWORD is changed makes every
# worker event upload fail with a 403.
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=changeme
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=changeme

# --- Langfuse application secrets ---
# openssl rand -hex 32, three times, for these:
SALT=changeme
ENCRYPTION_KEY=changeme
NEXTAUTH_SECRET=changeme
# Same port as LANGFUSE_WEB_PORT. This stays `localhost` even when
# LANGFUSE_WEB_BIND is not loopback: it is the origin a *browser* uses, and the
# UI is reached through an SSH port-forward onto localhost. It is unrelated to
# the address the eval process connects to, which is configs/tracing.yaml's
# langfuse.host. Point it elsewhere only if you browse the stack directly.
NEXTAUTH_URL=http://localhost:3000

# --- Non-secret compose toggles, pinned so this file fully defines the stack ---
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
REDIS_TLS_ENABLED=false

# --- Headless init: creates a ready org/project/user/API-key pair on first
# boot against an empty Postgres, so `docker compose up` needs no
# click-through setup. Re-running against an already-initialized Postgres is
# a no-op. project_id and the two keys below are what the harness
# authenticates with -- export them into its environment as
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY (never in a YAML config; see
# ../../configs/tracing.example.yaml). `scripts/gen_langfuse_env.sh
# --print-keys` prints the two export lines.
LANGFUSE_INIT_ORG_ID=default-org
LANGFUSE_INIT_ORG_NAME=Default Org
LANGFUSE_INIT_PROJECT_ID=default-project
LANGFUSE_INIT_PROJECT_NAME=Default Project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-changeme
LANGFUSE_INIT_USER_EMAIL=admin@example.invalid
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=changeme
