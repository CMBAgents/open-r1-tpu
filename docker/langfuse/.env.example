# Template for .env, the only settings docker-compose.yaml reads.
# scripts/gen_langfuse_env.sh fills it in as .env (gitignored) with fresh
# secrets and every value that must match another already matching. To write
# .env by hand instead, copy this file and replace every changeme: .env has no
# variable interpolation, so the pairs noted below must be kept equal by hand.

# --- Ports ---
# All bound to 127.0.0.1 by the compose file except the web port, which binds
# to LANGFUSE_WEB_BIND. Keep that at 127.0.0.1 on a single host, where the UI
# is reached through an SSH port-forward; any other address is reachable
# off-host and must be firewalled to the evaluation host. LANGFUSE_WEB_PORT
# must equal langfuse.port in configs/tracing.yaml.
LANGFUSE_WEB_BIND=127.0.0.1
LANGFUSE_WEB_PORT=3000
LANGFUSE_WORKER_PORT=3030
POSTGRES_PORT=5432
REDIS_PORT=6379
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
MINIO_API_PORT=9090
MINIO_CONSOLE_PORT=9091

# --- Datastore credentials (internal to the compose network) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres
# Langfuse connects with this, so it must embed POSTGRES_PASSWORD verbatim.
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/postgres

REDIS_HOST=redis
REDIS_AUTH=changeme

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_CLUSTER_ENABLED=false

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=changeme

# --- Langfuse's S3 client, pointed at the bundled MinIO ---
# For both buckets, ACCESS_KEY_ID must equal MINIO_ROOT_USER and
# SECRET_ACCESS_KEY must equal MINIO_ROOT_PASSWORD, or every event upload
# fails with a 403.
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=changeme
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=changeme

# --- Langfuse application secrets (openssl rand -hex 32 each) ---
SALT=changeme
ENCRYPTION_KEY=changeme
NEXTAUTH_SECRET=changeme
# The origin a browser uses, so it stays localhost whatever LANGFUSE_WEB_BIND
# is: the UI is reached through an SSH port-forward. Must name
# LANGFUSE_WEB_PORT.
NEXTAUTH_URL=http://localhost:3000

# --- Non-secret toggles, pinned so this file fully defines the stack ---
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
REDIS_TLS_ENABLED=false

# --- Headless init ---
# On first boot against an empty Postgres, creates this org, project, user and
# API key pair; later boots leave them alone. The evaluation authenticates with
# the key pair, exported as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY
# (scripts/gen_langfuse_env.sh --print-keys), never written into a config file.
LANGFUSE_INIT_ORG_ID=default-org
LANGFUSE_INIT_ORG_NAME=Default Org
LANGFUSE_INIT_PROJECT_ID=default-project
LANGFUSE_INIT_PROJECT_NAME=Default Project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-changeme
LANGFUSE_INIT_USER_EMAIL=admin@example.invalid
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=changeme
